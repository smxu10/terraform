pipeline {
    agent any
    environment {
        AWS_PROFILE = 'default'
        AWS_SDK_LOAD_CONFIG = 'true' // Recommended for profile loading
    }
    stages {
        stage('terraform') {
            steps {
                dir('ssm/parameter_store'){
                  bat '''
                    terraform init
                    terraform plan
                  '''
                }
            }
        }
    }
}
